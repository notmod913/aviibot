# Copy this file to .env and adjust as needed.

APP_ENV=development

# Optional for loopback-only development; required for non-local/production API access.
# Use a unique secret of at least 32 characters when configured.
# Example: python -c "import secrets; print(secrets.token_urlsafe(32))"
API_ACCESS_TOKEN=

# SQLite file path; relative paths resolve from the backend working directory.
DATABASE_PATH=./data/satark.sqlite3

# Explicit hostnames accepted by the backend; add your deployment hostname when hosted.
TRUSTED_HOSTS=localhost,127.0.0.1

# Comma-separated list of origins allowed to call this API from a browser.
# Should include wherever the Inspector Portal (Member 2) is running.
ALLOWED_ORIGINS=http://localhost:4175,http://127.0.0.1:4175,http://localhost:4176,http://127.0.0.1:4176,http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Optional registered inspection-site coordinates, keyed by organization name.
# Use real verified locations before relying on the server's radius check.
SITE_LOCATIONS_JSON={}
